# ============================================
# PastureAI — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# Google Gemini AI (for executive briefs & insights)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Earth Engine (for Sentinel-2 NDVI processing)
# Preferred: path to the downloaded service-account JSON file (avoids .env escaping issues)
GEE_SERVICE_ACCOUNT_FILE=./gee-service-account.json
# Or paste the full JSON as a single line (quotes required if it contains spaces):
# GEE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com"}'
GEE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GEE_PROJECT_ID=your_gcp_project_id

# Open-Meteo Weather API (free tier, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS if needed)
FRONTEND_URL=http://localhost:5173
